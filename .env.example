# ==========================================
# Aether ITSM - Environment Configuration
# ==========================================

# JWT Security
JWT_SECRET_KEY="tu_super_secreto_aqui_para_produccion"
JWT_ALGORITHM="HS256"

# Database Configuration (Supabase PostgreSQL or Local SQLite)
# Ej: DATABASE_URL="postgresql://postgres.[PROYECTO]:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres"
# Si dejas esto vacío, usará SQLite local (app.db)
DATABASE_URL=""

# 1. Local Testing / Development (Zero Cost)
# Set to True to use local Ollama models.
USE_OLLAMA="True"
OLLAMA_MODEL="llama3.1"

# 2. Production / Hackathon (Nebius Token Factory)
# If USE_OLLAMA="False", the system will use the Nebius API.
# NEBIUS_API_KEY="sk-tu-llave-de-nebius-aqui"

# 3. Fallback (OpenAI Standard)
# OPENAI_API_KEY="sk-tu-llave-de-openai-aqui"
SUPERADMIN_PASSWORD=your_secure_password_here

ENCRYPTION_KEY="your_32_byte_urlsafe_base64_encryption_key_here"

# ── Background jobs (durable queue, roadmap 2.2) ──
# true: the API process also runs the worker (dev). In production set false
# and run the worker separately:  python -m src.jobs.worker
JOBS_EMBEDDED_WORKER="True"
JOBS_CONCURRENCY="2"

# ── Observability (roadmap 2.4) ──
LOG_FORMAT="text"            # text | json
# USD per 1M tokens per model id, from YOUR provider contract (not guessed):
# LLM_PRICES_JSON='{"nvidia/llama-3.3-nemotron-super-49b-v1": [0.0, 0.0]}'
LLM_PRICES_JSON="{}"
# Optional LangSmith tracing (LangChain picks these up automatically):
# LANGSMITH_TRACING="true"
# LANGSMITH_API_KEY="..."

# ── Row-Level Security (roadmap 2.5) ──
# Only after running: python scripts/apply_rls.py   (rollback: --rollback)
DB_RLS_ENABLED="False"

# ── Health checks (Fase 11.4) ──
# Self-hosted deployments that must check intranet services only.
ALLOW_PRIVATE_HEALTHCHECK_TARGETS="False"
